# Production: all URLs must use the same HTTPS origin.
NODE_ENV=production
APP_ORIGIN=https://YOUR-GAME-DOMAIN
# Mount a persistent Render disk here BEFORE running production.
ACCOUNT_DB=/var/data/drift.sqlite
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
MAIL_FROM=Drift Racer <accounts@YOUR-VERIFIED-DOMAIN>
